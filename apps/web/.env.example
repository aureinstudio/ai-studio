# ─────────────────────────────────────────────────────────
# ai-studio · 환경변수 템플릿 (committable)
# 실제 값은 .env.local에 작성. 본 파일은 키 *이름*만 정의.
# 신규 개발자 온보딩 시: cp .env.example .env.local
# ─────────────────────────────────────────────────────────

# ───── Supabase ─────
# 위치: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...   # ⚠️ 서버 전용

# ───── Anthropic Claude ─────
# 위치: https://console.anthropic.com/settings/keys
# ⚠️ 서버 전용 — NEXT_PUBLIC_ 접두사 절대 금지
ANTHROPIC_API_KEY=sk-ant-api03-...

# ───── ElevenLabs (TTS) ─────
# 위치: https://elevenlabs.io/app/settings/api-keys
# ⚠️ 서버 전용. 가격: ~$0.30/1000자 (음성 생성)
ELEVENLABS_API_KEY=

# ───── HeyGen (Avatar Video) ─────
# 위치: https://app.heygen.com/settings/api
# ⚠️ 서버 전용. 가격: ~$0.50/분 (영상 생성, 가장 비쌈)
HEYGEN_API_KEY=

# ───── 비용 가드레일 (선택, 기본값 사용 권장) ─────
# Studio LLM 일일 한도
# NEXT_PUBLIC_DAILY_USD_LIMIT=50
# Cast TTS·Avatar 일일 한도 (Studio보다 10배 비싸므로 별도 관리)
# CAST_DAILY_LIMIT_USD=30
