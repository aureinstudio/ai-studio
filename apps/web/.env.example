# ─────────────────────────────────────────────────────────
# ai-studio · 환경변수 템플릿 (committable)
# 실제 값은 .env.local에 작성. 본 파일은 키 *이름*만 정의.
# 신규 개발자 온보딩 시: cp .env.example .env.local
# ─────────────────────────────────────────────────────────

# ───── Supabase ─────
# 위치: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...   # ⚠️ 서버 전용

# ───── Anthropic Claude ─────
# 위치: https://console.anthropic.com/settings/keys
# ⚠️ 서버 전용 — NEXT_PUBLIC_ 접두사 절대 금지
ANTHROPIC_API_KEY=sk-ant-api03-...

# ───── ElevenLabs (TTS) ─────
# 위치: https://elevenlabs.io/app/settings/api-keys
# ⚠️ 서버 전용. 가격: ~$0.30/1000자 (음성 생성)
ELEVENLABS_API_KEY=

# ───── HeyGen (Avatar Video) ─────
# 위치: https://app.heygen.com/settings/api
# ⚠️ 서버 전용. 플랜별 단가 (실측):
#   Pay-as-you-go: $2~$6/분 / Creator $24/월: ~$2/분 / Team $79/월: ~$0.5/분
HEYGEN_API_KEY=
# 본부장 플랜의 실제 분당 단가 (기본 2.0). cost-guard·KPI 정확도에 직결.
# HEYGEN_USD_PER_MINUTE=2.0

# ───── Google Gemini (Avatar 이미지 생성 + RAG 임베딩) ─────
# 위치: https://aistudio.google.com/app/apikey
# ⚠️ 서버 전용. Imagen·Nano Banana·gemini-embedding-001 사용.
GEMINI_API_KEY=
# 또는 GOOGLE_API_KEY (둘 다 지원)
GOOGLE_API_KEY=

# ───── Resend (이메일 알림 발송) ─────
# 위치: https://resend.com/api-keys
# Free tier: 3,000 emails/월, 100/일. 미설정 시 조용히 스킵 (fail-soft).
RESEND_API_KEY=
# 발신자 (도메인 검증 전: onboarding@resend.dev 사용 가능)
EMAIL_FROM=KEG AI Studio <onboarding@resend.dev>
# 수신자 (쉼표 구분, 예: "admin1@keg.com,admin2@keg.com")
ADMIN_ALERT_EMAILS=

# ───── Upstash Redis (Rate Limiting) ─────
# 위치: https://console.upstash.com — Create Database (Regional, gratis tier OK)
# 미설정 시 fail-open (rate limit 검사 통과). Production은 반드시 설정.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ───── 비용 가드 한도 (선택, USD, 기본값은 cost-guard/index.ts 참조) ─────
# 학생 1인당 일일·월간 / 전역 일일·월간 / Cast 별도
# COST_USER_DAILY_USD=5
# COST_USER_MONTHLY_USD=50
# COST_GLOBAL_DAILY_USD=100
# COST_GLOBAL_MONTHLY_USD=1000
# COST_CAST_USER_DAILY_USD=2
# COST_CAST_GLOBAL_DAILY_USD=30

# ───── Vercel Cron Secret ─────
# Vercel Dashboard → Settings → Environment Variables에서 임의 secret 생성
# Vercel Cron이 이 secret으로 인증
CRON_SECRET=

# ───── Public Base URL (이메일 링크에 사용) ─────
NEXT_PUBLIC_BASE_URL=https://ai-studio-drab-nine.vercel.app

# ───── PostHog (사용자 행동 분석, 선택) ─────
# 위치: https://posthog.com — Project Settings → Project API Key
# Free tier: 1M events/월. 미설정 시 트래킹 noop.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ───── 비용 가드레일 (선택, 기본값 사용 권장) ─────
# Studio LLM 일일 한도
# NEXT_PUBLIC_DAILY_USD_LIMIT=50
# Cast TTS·Avatar 일일 한도 (Studio보다 10배 비싸므로 별도 관리)
# CAST_DAILY_LIMIT_USD=30
